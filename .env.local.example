NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase's "Connect" panel now calls this the "Publishable Key" (starts
# with sb_pub_...) instead of the older "anon key" (a long eyJ... JWT).
# The app accepts either name/value — use whichever one Supabase shows you.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# SERVER-ONLY — never expose this to the browser. Used only for background
# email processing (investor notifications), which needs to bypass RLS.
# Find it in Supabase: Project Settings -> API Keys -> service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Brevo transactional email API (NOT the SMTP key — this is the "API Key"
# from Brevo -> SMTP & API -> API Keys tab, starts with xkeysib-)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@engineerbhairdokan.store
BREVO_SENDER_NAME=Engineer Bhai'r Dokan
